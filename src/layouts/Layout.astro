<style>
  html,
  body {
    margin: 0;
    width: 100%;
    background: #071311 ;
    height: 100vh;
    background-image: var(--gradient);
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    scroll-behavior: smooth;
    font-family: Arial, Helvetica, sans-serif;
     overflow-x: hidden;
  }
</style>
