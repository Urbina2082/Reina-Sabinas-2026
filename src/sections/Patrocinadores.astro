---
import InitSection from "../components/InitSection.astro";
---

<div class="patro">
  <InitSection
    title=""
    subtitle=""
    subtitle2="Patrocinadores"
    description="Este evento puede llevarse a cabo gracias al apoyo de nuestros patrocinadores..."
  />

  <div class="pat">
    <div class="logo">
      <img src="Patro/1.avif" alt="Patrocinador 1" />
    </div>

    <div class="logo">
      <img src="Patro/2.avif" alt="Patrocinador 2" />
    </div>

    <div class="logo">
      <img src="Patro/3.avif" alt="Patrocinador 3" />
    </div>

    <div class="logo">
      <img src="Patro/4.avif" alt="Patrocinador 4" />
    </div>

    <div class="logo">
      <img src="Patro/5.avif" alt="Patrocinador 5" />
    </div>

    <div class="logo">
      <img src="Patro/6.avif" alt="Patrocinador 6" />
    </div>

    <div class="logo">
      <img src="Patro/7.avif" alt="Patrocinador 7" />
    </div>
    <div class="logo">
      <img src="Patro/8.avif" alt="Patrocinador 7" />
    </div>
    <div class="logo">
      <img src="Patro/9.avif" alt="Patrocinador 7" />
    </div>
    <div class="logo">
      <img src="Patro/10.avif" alt="Patrocinador 7" />
    </div>
    <div class="logo">
      <img src="Patro/11.avif" alt="Patrocinador 7" />
    </div>
    <div class="logo">
      <img src="Patro/12.avif" alt="Patrocinador 7" />
    </div>
    <div class="logo">
      <img src="Patro/13.avif" alt="Patrocinador 7" />
    </div>
  </div>
</div>

<style>
  .patro {
    margin: 0rem 0rem 4rem;
    padding: 1rem;
  }
  .pat {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4rem;
  }

  .logo {
    width: 180px;
    aspect-ratio: 3 / 2;
    background: #ffffff;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  @media (max-width: 768px) {
    .pat {
      gap: 1rem;
    }

    .logo {
      width: 110px;
    }
  }
</style>
