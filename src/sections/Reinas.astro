---
import ReinaCard from "../components/Reinas/Reina-card.astro";
import InitSection from "../components/InitSection.astro";

const Candidatas = [
  {
    id: "Larisa Veronica Guevara Ramos",
    nombre: "LARISA GUEVARA",
    edad: "24 años",
    instagram: "Larisa_guevara12",
    frase: ` “Representar con el corazón vale más que destacar por la perfección”`,
    img: "/Candidatas/Larisa.avif",
     color:"Rojo. ❤️",
    repre:"CMPI"
  },
  {
    id: "María Lucía Ramos Montemayor",
    nombre: "MARÍA RAMOS",
    edad: "16 años",
    instagram: "mariluramos_",
    frase: ` "La belleza real se mide por la empatía que despierta."`,
    img: "/Candidatas/maria.avif",
     color:"Verde 💚",
    repre:"CENTRO DE ATENCION MULTIPLE"
  },
  {
    id: "María Fernanda Rodríguez Guerra",
    nombre: "FERNANDA RODRÍGUEZ",
    edad: "16 años",
    instagram: "ferr__rdz",
    frase: ` "Vive de una manera que siempre quieras volver a vivir."`,
    img: "/Candidatas/fernanda.avif",
     color:"Azul 💙",
    repre:"CLUB DE LEONES"
  },
  {
    id: "Anahí Alejandra Ruiz Wislar ",
    nombre: "ANAHÍ RUIZ",
    edad: "20 años",
    instagram: "ana30_rw",
    frase: `"Los sueños se cumplen cuando te atreves a dar el primer paso."`,
    img: "/Candidatas/Anahi.avif",
    color:"Blanco.🤍",
    repre:"CRUZ ROJA"
  },
  {
    id: "Virginia Kamyla Vazquez Granados",
    nombre: "KAMYLA VÁZQUEZ",
    edad: "20 años",
    instagram: "Granados.kv",
    frase: `  "Con la vocación de enseñar, el corazón para servir y el brillo para inspirar."  `,
    img: "/Candidatas/Kamila.avif",
     color:"Amarillo 💛",
    repre:"BOMBEROS"
  },
  {
    id: "Jimena Hidalgo Robledo",
    nombre: "JIMENA HIDALGO",
    edad: "17 años",
    instagram: "h1_jimena",
    frase: ` "Cabalgando hacia un sueño” `,
    img: "/Candidatas/Jimena.avif",
     color:"Rosa fiusha. 🩷",
    repre:"SENDEROS SAN VALENTIN"
  }
];
---

<div class="Reinas" id="Candidatas">

    <InitSection
     title="CANDIDATAS 2026"
    subtitle="CONOCE A NUESTRAS"
    subtitle2="CANDIDATAS"
    description="Descubre a las talentosas mujeres que compiten por la corona este año y conoce más sobre su belleza, carisma y preparación en esta emocionante competencia."/>

   <div class="tarjetas" >

  
  {
    Candidatas.map((candi) => (
     
        <ReinaCard class="tar" 
          nombre={candi.nombre}
          edad={candi.edad}
          frase={candi.frase}
          insta={candi.instagram}
          img={candi.img}
           repre={candi.repre}
           color={candi.color}
        />
      
    ))
  } </div>
</div>

<style>
  .Reinas {
    padding: 6rem 0rem;

    background-image: linear-gradient(
      to top,
      #ffffff01 0%,FFFF
      #ffffff09 50%,
      #ffffff01 100%
    );
    margin: auto;
  }

  .tarjetas {
    display: flex;
gap: 5rem;
    flex-wrap: wrap;
    margin: 3rem auto;
    justify-content: center;
    padding: 0rem 1rem;
  }

  .tar
</style>
