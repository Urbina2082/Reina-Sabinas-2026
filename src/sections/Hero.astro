<style>
  .hero {
    position: relative; /* agrega esto */
    min-height: 100svh; /* mejor para móviles */
    height: 100vh;
    background-image:
      linear-gradient(to top, #00000086, #0000007a), url(/junt.avif);
    background-position: top;
    background-size: cover;
    background-repeat: no-repeat;
    text-align: center;
  }

  /* img {
    width: 140px;
    margin-top: 30px;
  } */

  .hero b {
    display: block;
    font-size: var(--text-small);
    margin-top: 20px;
    font-weight: 300;
    color: hsl(var(--champagne));
    letter-spacing: 0.3em;
  }

  h2 {
    font-size: clamp(1.9rem, 4.5vw, 4.5rem);
    margin-top: 10px;
    font-family: var(--font-Principal);
    font-weight: 300;
    color: white;
    line-height: 1.25;
    margin: 10px auto;
    max-width: 48rem;
  }
  .conj {
    position: absolute;
    bottom: 10px;
    left: 0;
    right: 0;

    text-align: center;
    padding: 0 1rem;
  }

  h2 span {
    background-image: var(--gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  p {
    font-size: var(--text-small);
    margin-top: 20px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    font-weight: 400;
    color: hsl(var(--champagne));
    line-height: 1.5rem;
  }

  /* button {
    margin-top: 20px;
    background: #ffffff00;
    border: 1px solid #ffffff7b;
    color: white;

    padding: 10px 30px;
    font-size: var(--text-small);
    font-weight: 400;
    border-radius: 25px;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
  } */

  @media (max-width: 768px) {
    .hero b {
      font-size: 0.9rem;
    }
  }
</style>
